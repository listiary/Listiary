
RewriteEngine on
RewriteCond %{HTTP_HOST} ^demo\.listiary\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.demo\.listiary\.com$
RewriteRule ^(.*)$ "https\:\/\/demo\.listiary\.org\/$1" [R=301,L]
RewriteCond %{HTTP_HOST} ^demo\.listiary\.net$ [OR]
RewriteCond %{HTTP_HOST} ^www\.demo\.listiary\.net$
RewriteRule ^(.*)$ "https\:\/\/demo\.listiary\.org\/$1" [R=301,L]

#----------------------------------------------------------------cp:ppd
# Section managed by cPanel: Password Protected Directories     -cp:ppd
# - Do not edit this section of the htaccess file!              -cp:ppd
